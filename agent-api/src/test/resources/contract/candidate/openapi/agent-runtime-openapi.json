            "description" : "Internal error"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RuntimeErrorResponse"
                }
              }
            },
            "description" : "Provider unavailable"
          },
          "504" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RuntimeErrorResponse"
                }
              }
            },
            "description" : "Deadline exceeded"
          }
        },
        "security" : [ {
          "InternalServiceAuth" : [ ]
        } ]
      }
    },
