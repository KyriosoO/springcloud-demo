                  "$ref" : "#/components/schemas/RuntimeErrorResponse"
                }
              }
            },
            "description" : "Authentication failed"
          },
          "422" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RuntimeErrorResponse"
                }
              }
