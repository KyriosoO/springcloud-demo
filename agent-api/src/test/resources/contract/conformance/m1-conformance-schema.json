{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "TYPE_A"
        }
      },
      "required": [
        "valueA"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "TYPE_B"
        }
      },
      "required": [
        "valueB"
      ]
    }
  ],
  "properties": {
    "durationMs": {
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "valueA": {
      "type": "string"
    },
    "valueB": {
      "type": "string"
    }
  },
  "required": [
    "durationMs",
    "kind",
    "occurredAt"
  ],
  "type": "object"
}
