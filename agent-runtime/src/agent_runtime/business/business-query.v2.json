{
  "config_version": "business-query-v2",
  "code_contract_version": "business-query-contract-v2",
  "domains": [
    {
      "domain": "employee",
      "enabled": true,
      "actions": [
        {
          "action": "employee.search",
          "enabled": true,
          "code_contract_version": "employee-search-plan-v2",
          "service_contract_ref": "employee.es.search.v1",
          "pagination": {"max_page": 1000, "max_size": 50, "max_results": 50},
          "sorts": {"max_items": 2, "directions": ["ASC", "DESC"], "fields": ["chinese_name", "position"]},
          "keyword": {
            "enabled": true,
            "input_exposure": "literal_or_protected_ref",
            "max_text_chars": 128,
            "service_field_ids": ["contactAddress", "chineseName", "idCardNo"]
          },
          "timeout_ms": 3000,
          "fields": [
            {"logical_name": "contact_address", "service_field": "contactAddress", "model_safe_description": "员工联系地点的非敏感城市片段", "value_type": "text", "enabled": true, "allowed_operators": ["eq", "contains", "prefix", "in"], "input_exposure": "literal_or_protected_ref", "required": false, "max_text_chars": 128, "data_class": "contact", "user_visible": true, "user_transform": "mask_address", "model_visible": false, "sortable": false},
            {"logical_name": "chinese_name", "service_field": "chineseName", "model_safe_description": "当前请求中员工姓名的受保护引用", "value_type": "text", "enabled": true, "allowed_operators": ["eq", "contains", "prefix", "in"], "input_exposure": "protected_ref", "required": false, "max_text_chars": 128, "data_class": "personal_identifier", "user_visible": true, "user_transform": "mask_name", "model_visible": false, "sortable": true},
            {"logical_name": "employee_identifier", "service_field": "idCardNo", "model_safe_description": "当前请求中员工标识的受保护引用", "value_type": "identifier", "enabled": true, "allowed_operators": ["eq"], "input_exposure": "protected_ref", "required": false, "data_class": "personal_identifier", "user_visible": true, "user_transform": "mask_keep_last4", "model_visible": false, "sortable": false},
            {"logical_name": "member_no", "service_field": "memberNo", "model_safe_description": "当前请求中会员编号的受保护引用", "value_type": "identifier", "enabled": true, "allowed_operators": ["eq", "prefix"], "input_exposure": "protected_ref", "required": false, "data_class": "employee_identifier", "user_visible": true, "user_transform": "mask_keep_last4", "model_visible": false, "sortable": false},
            {"logical_name": "phone_no", "service_field": "phoneNo", "model_safe_description": "当前请求中员工联系电话的受保护引用", "value_type": "text", "enabled": true, "allowed_operators": ["eq", "prefix"], "input_exposure": "protected_ref", "required": false, "max_text_chars": 128, "data_class": "contact", "user_visible": true, "user_transform": "mask_contact", "model_visible": false, "sortable": false},
            {"logical_name": "email", "service_field": "email", "model_safe_description": "当前请求中员工邮箱的受保护引用", "value_type": "text", "enabled": true, "allowed_operators": ["eq"], "input_exposure": "protected_ref", "required": false, "max_text_chars": 128, "data_class": "contact", "user_visible": true, "user_transform": "mask_contact", "model_visible": false, "sortable": false},
            {"logical_name": "position", "service_field": "position", "model_safe_description": "员工职位的非敏感业务文本", "value_type": "text", "enabled": true, "allowed_operators": ["eq", "contains", "prefix", "in"], "input_exposure": "literal", "required": false, "max_text_chars": 128, "data_class": "business_internal", "user_visible": true, "user_transform": "bounded_text", "model_visible": true, "model_transform": "bounded_text", "sortable": true}
          ]
        },
        {
          "action": "employee.semantic_search",
          "enabled": true,
          "code_contract_version": "employee-semantic-search-plan-v2",
          "service_contract_ref": "employee.es.vector-search.v1",
          "pagination": {"max_page": 1, "max_size": 50, "max_results": 50},
          "semantic_profile_id": "employee-default-v1",
          "timeout_ms": 3000,
          "fields": [
            {"logical_name": "query", "service_field": "queryText", "model_safe_description": "不包含姓名、地址、标识或联系方式的员工专业能力描述", "value_type": "text", "enabled": true, "allowed_operators": ["eq"], "input_exposure": "literal", "required": true, "max_text_chars": 256, "data_class": "business_internal", "user_visible": false, "model_visible": false, "sortable": false}
          ],
          "result_fields": [
            {"field_id": "contact_address", "user_transform": "mask_address", "model_visible": false},
            {"field_id": "chinese_name", "user_transform": "mask_name", "model_visible": false},
            {"field_id": "employee_identifier", "user_transform": "mask_keep_last4", "model_visible": false},
            {"field_id": "member_no", "user_transform": "mask_keep_last4", "model_visible": false},
            {"field_id": "phone_no", "user_transform": "mask_contact", "model_visible": false},
            {"field_id": "email", "user_transform": "mask_contact", "model_visible": false},
            {"field_id": "position", "user_transform": "bounded_text", "model_visible": true, "model_transform": "bounded_text"}
          ]
        }
      ]
    },
    {
      "domain": "transaction",
      "enabled": true,
      "actions": [
        {
          "action": "transaction.search",
          "enabled": true,
          "code_contract_version": "transaction-search-plan-v2",
          "service_contract_ref": "transaction.search.v1",
          "pagination": {"max_page": 1000, "max_size": 50, "max_results": 50},
          "sorts": {"max_items": 2, "directions": ["ASC", "DESC"], "fields": ["trans_id", "trans_type", "trans_date", "amount"]},
          "decimal": {"max_abs": "9999999999999999.99", "max_scale": 2},
          "time": {"timezone": "Asia/Shanghai", "max_range_days": 366, "allow_relative_dates": false},
          "timeout_ms": 5000,
          "fields": [
            {"logical_name": "trans_id", "service_field": "transId", "model_safe_description": "当前请求中交易标识的受保护引用", "value_type": "identifier", "enabled": true, "allowed_operators": ["eq"], "input_exposure": "protected_ref", "required": false, "data_class": "transaction_identifier", "user_visible": true, "user_transform": "mask_keep_last4", "model_visible": false, "sortable": true},
            {"logical_name": "trans_type", "service_field": "transType", "model_safe_description": "交易类型的精确或包含匹配业务文本", "value_type": "text", "enabled": true, "allowed_operators": ["eq", "contains"], "input_exposure": "literal", "required": false, "max_text_chars": 128, "data_class": "business_internal", "user_visible": true, "user_transform": "bounded_text", "model_visible": true, "model_transform": "bounded_text", "sortable": true},
            {"logical_name": "trans_date", "service_field": "transDate", "model_safe_description": "包含明确时区偏移的绝对交易时间", "value_type": "datetime", "enabled": true, "allowed_operators": ["eq", "gt", "lt"], "input_exposure": "literal", "required": false, "data_class": "business_internal", "user_visible": true, "user_transform": "datetime_iso", "model_visible": false, "sortable": true},
            {"logical_name": "amount", "service_field": "amount", "model_safe_description": "最多两位小数的规范十进制交易金额", "value_type": "decimal", "enabled": true, "allowed_operators": ["eq", "gt", "lt"], "input_exposure": "literal", "required": false, "data_class": "financial_value", "user_visible": true, "user_transform": "decimal_2", "model_visible": true, "model_transform": "decimal_2", "sortable": true}
          ]
        }
      ]
    }
  ]
}
