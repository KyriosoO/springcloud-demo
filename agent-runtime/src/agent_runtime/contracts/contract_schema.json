{
  "$defs": {
    "ContractMetadata": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "contractFingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "contractVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "contractFingerprint",
        "contractVersion"
      ],
      "type": "object"
    },
    "RuntimeError": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "code": {
          "enum": [
            "CONTRACT_FINGERPRINT_MISMATCH",
            "CONTRACT_PAYLOAD_INVALID",
            "CONTRACT_VERSION_UNSUPPORTED",
            "DEADLINE_EXCEEDED",
            "RUNTIME_CANCELLED",
            "RUNTIME_CAPABILITY_UNAVAILABLE",
            "RUNTIME_CONTRACT_INCOMPATIBLE",
            "RUNTIME_INTERNAL_ERROR"
          ],
          "type": "string"
        },
        "contractFingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "contractVersion": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        "diagnosticId": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "executionId": {
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "contractFingerprint",
        "contractVersion",
        "diagnosticId",
        "message"
      ],
      "type": "object"
    },
    "RuntimeReadiness": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/ContractMetadata"
        },
        "reasons": {
          "items": {
            "enum": [
              "CONTRACT_CAPABILITY_INCONSISTENT",
              "CONTRACT_METADATA_INVALID",
              "CONTRACT_MODEL_LOAD_FAILED"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "CONTRACT_NOT_READY",
            "CONTRACT_READY"
          ],
          "type": "string"
        }
      },
      "required": [
        "metadata",
        "reasons",
        "status"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
