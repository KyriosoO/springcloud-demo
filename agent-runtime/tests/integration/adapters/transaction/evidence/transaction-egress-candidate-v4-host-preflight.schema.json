{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "manifestSha256", "authorizationReference", "sequence", "event", "status", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"const": "transaction-egress-v4-20260817-candidate-04"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizationReference": {"const": "P3_00:GATE-026"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 4},
    "event": {"enum": ["preflight", "asset_binding", "python_collection"]},
    "status": {"enum": ["started", "succeeded", "failed", "skipped", "passed", "failed_unconsumed"]},
    "reason": {"type": ["string", "null"], "enum": [null, "asset_hash_invalid", "manifest_binding_invalid", "python_import_failed", "python_import_source_invalid", "python_collection_failed", "preflight_internal_failure"]}
  }
}
