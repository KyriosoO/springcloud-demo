{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-runtime:employee-egress-v3-lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "manifestSha256", "authorizationReference", "sequence", "phase", "state", "reason", "failurePhase", "ordinal"],
  "properties": {
    "schemaVersion": {"const": 3},
    "runId": {"const": "employee-egress-v3-20260817-candidate-03"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizationReference": {"const": "P3_00:GATE-024"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 75},
    "phase": {"enum": ["run", "fixture_precheck", "fixture_insert", "fixture_verify", "employee_detail", "model_answer", "cleanup_delete", "cleanup_verify", "host_validation"]},
    "state": {"enum": ["started", "succeeded", "failed", "answer", "invalid_output", "input_denied", "timeout", "provider_failure", "passed", "failed_unconsumed", "failed_consumed", "failed_cleanup_required"]},
    "reason": {"enum": ["none", "identifier_conflict", "database_operation_failed", "employee_request_failed", "employee_result_invalid", "egress_projection_invalid", "model_setup_failed", "model_call_failed", "threshold_not_met", "cleanup_failed", "log_leak_detected", "host_failed", "evidence_write_failed"]},
    "failurePhase": {"enum": ["none", "fixture_precheck", "fixture_insert", "fixture_verify", "employee_detail", "model_setup", "model_answer", "threshold", "cleanup_delete", "cleanup_verify", "host_validation"]},
    "ordinal": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 30}]}
  }
}
