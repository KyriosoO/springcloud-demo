{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "employee-test-data-fixture-candidate-v1-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preparationWorkPackageId",
    "workPackageId",
    "gateId",
    "runId",
    "manifestSha256",
    "authorizationReference",
    "status",
    "reason",
    "fieldNames",
    "sourceHistory",
    "counts",
    "safety",
    "lifecycleSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "preparationWorkPackageId": {"const": "WP-EMP-EGRESS-TEST-DATA-CANDIDATE-01-PREP"},
    "workPackageId": {"const": "WP-EMP-EGRESS-TEST-DATA-CANDIDATE-01"},
    "gateId": {"const": "GATE-051"},
    "runId": {"const": "employee-synthetic-fixture-v1-20260814-candidate-01"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizationReference": {"const": "P3_00:GATE-051"},
    "status": {"enum": ["passed", "failed", "failed_cleanup_required"]},
    "reason": {
      "enum": [
        "none",
        "identifier_conflict",
        "database_operation_failed",
        "insert_count_invalid",
        "fingerprint_mismatch",
        "consumer_failure",
        "cleanup_count_invalid",
        "cleanup_verification_failed",
        "host_execution_failed",
        "log_leak_detected"
      ]
    },
    "fieldNames": {"const": ["idCardNo", "chineseName", "position", "workBaseSi"]},
    "sourceHistory": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseSelectStarted",
        "databaseSelectTerminal",
        "databaseInsertStarted",
        "databaseInsertTerminal",
        "databaseDeleteStarted",
        "databaseDeleteTerminal",
        "preexisting",
        "inserted",
        "verified",
        "deleted",
        "remaining",
        "consumerCalls",
        "employeeEndpointCalls",
        "modelCalls",
        "retryCount",
        "resumeCount"
      ],
      "properties": {
        "databaseSelectStarted": {"type": "integer", "minimum": 0, "maximum": 3},
        "databaseSelectTerminal": {"type": "integer", "minimum": 0, "maximum": 3},
        "databaseInsertStarted": {"type": "integer", "minimum": 0, "maximum": 1},
        "databaseInsertTerminal": {"type": "integer", "minimum": 0, "maximum": 1},
        "databaseDeleteStarted": {"type": "integer", "minimum": 0, "maximum": 1},
        "databaseDeleteTerminal": {"type": "integer", "minimum": 0, "maximum": 1},
        "preexisting": {"type": "integer", "minimum": 0, "maximum": 1},
        "inserted": {"type": "integer", "minimum": 0, "maximum": 1},
        "verified": {"type": "integer", "minimum": 0, "maximum": 1},
        "deleted": {"type": "integer", "minimum": 0, "maximum": 1},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 1},
        "consumerCalls": {"type": "integer", "minimum": 0, "maximum": 1},
        "employeeEndpointCalls": {"const": 0},
        "modelCalls": {"const": 0},
        "retryCount": {"const": 0},
        "resumeCount": {"const": 0}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "nonRealIdentifier",
        "identifierPersisted",
        "fixtureFingerprintPersisted",
        "fieldValuesPersisted",
        "existingRowsModified",
        "publicApiCalls",
        "jwtRead",
        "llmApiKeyRead",
        "modelOutbound",
        "logLeakCount",
        "rawLogsDeleted"
      ],
      "properties": {
        "synthetic": {"const": true},
        "nonRealIdentifier": {"const": true},
        "identifierPersisted": {"const": false},
        "fixtureFingerprintPersisted": {"const": false},
        "fieldValuesPersisted": {"const": false},
        "existingRowsModified": {"const": 0},
        "publicApiCalls": {"const": 0},
        "jwtRead": {"const": false},
        "llmApiKeyRead": {"const": false},
        "modelOutbound": {"const": false},
        "logLeakCount": {"type": "integer", "minimum": 0, "maximum": 1000},
        "rawLogsDeleted": {"type": "boolean"}
      }
    },
    "lifecycleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
