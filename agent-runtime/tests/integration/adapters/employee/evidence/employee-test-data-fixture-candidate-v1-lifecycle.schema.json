{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "employee-test-data-fixture-candidate-v1-lifecycle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workPackageId",
    "gateId",
    "runId",
    "manifestSha256",
    "authorizationReference",
    "sequence",
    "phase",
    "state",
    "reason"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "workPackageId": {"const": "WP-EMP-EGRESS-TEST-DATA-CANDIDATE-01"},
    "gateId": {"const": "GATE-051"},
    "runId": {"const": "employee-synthetic-fixture-v1-20260814-candidate-01"},
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorizationReference": {"const": "P3_00:GATE-051"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 16},
    "phase": {
      "enum": [
        "run",
        "precheck",
        "insert",
        "verify",
        "consumer",
        "cleanup_delete",
        "cleanup_verify",
        "host_validation"
      ]
    },
    "state": {"enum": ["started", "succeeded", "failed"]},
    "reason": {
      "enum": [
        "none",
        "identifier_conflict",
        "database_operation_failed",
        "insert_count_invalid",
        "fingerprint_mismatch",
        "consumer_failure",
        "cleanup_count_invalid",
        "cleanup_verification_failed",
        "host_execution_failed",
        "log_leak_detected"
      ]
    }
  }
}
