        "serviceUsesMapPayload": { "const": true },
        "insertWritesOnlyPresentKey": { "const": true },
        "updateWritesOnlyPresentKey": { "const": true },
        "typedWriteRequestDto": { "const": false },
        "workBaseRequiredValidation": { "const": false },
        "workBaseDefaulting": { "const": false },
        "workBaseBackfill": { "const": false },
        "esRebuildIsDownstream": { "const": true }
