        "entitySetter": { "const": true },
        "resultMap": { "const": true },
        "selectColumn": { "const": true },
        "insertColumn": { "const": true },
        "updateColumn": { "const": true },
        "priorAggregateDirectColumn": { "const": true }
      }
    },
    "writeSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controllerUsesMapPayload", "serviceUsesMapPayload", "insertWritesOnlyPresentKey", "updateWritesOnlyPresentKey", "typedWriteRequestDto", "workBaseRequiredValidation", "workBaseDefaulting", "workBaseBackfill", "esRebuildIsDownstream"],
