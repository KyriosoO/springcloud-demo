    "repositoryAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["employeeDdlAssets", "employeeDataAssets", "employeeInitializationComponents", "employeeImportComponents", "employeeBackfillComponents"],
      "properties": {
        "employeeDdlAssets": { "const": 0 },
        "employeeDataAssets": { "const": 0 },
        "employeeInitializationComponents": { "const": 0 },
        "employeeImportComponents": { "const": 0 },
        "employeeBackfillComponents": { "const": 0 }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "readMappingCauseExcluded", "physicalColumnDefinition", "rawValueDistribution", "confidence", "nextStep"],
      "properties": {
        "reason": { "const": "data_population_provenance_gap" },
        "readMappingCauseExcluded": { "const": true },
        "physicalColumnDefinition": { "const": "not_versioned" },
        "rawValueDistribution": { "const": "not_observable_without_separate_query" },
